# SCENARIO
# A restaurant wants a simple ordering system that allows customers
# to browse a menu, select items, and calculate their total bill.

menu = {
    "Burger": 12.00,
    "Pizza": 15.00,
    "Salad": 9.00,
    "Fries": 5.00,
    "Drink": 3.00
}

order = []

# TODO 1: Print out the entire menu and the price of each item
print("MENU")

for item in menu:
    print(item, "- $", menu[item])

# TODO 2: Start a loop, asking the customer which item they would like to order
while True:
    customerChoice = input("Which item would you like to order? ")

    # TODO 3 & 5: Check if customer is finished
    if customerChoice == "Done":
        break

    # Check whether the requested item exists
    if customerChoice in menu:

        # TODO 4: Add valid items to the order
        order.append(customerChoice)
        print(customerChoice, "added to your order.")

    else:
        print("Sorry, that item is not on the menu.")

# TODO 6: Print an itemized receipt
print("Order:")

subtotal = 0

for item in order:
    print(item, "- $", menu[item])
    subtotal = subtotal + menu[item]

# TODO 7: Print subtotal
print("TOTAL: $", round(subtotal, 2))
